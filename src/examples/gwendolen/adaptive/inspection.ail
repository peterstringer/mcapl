mas.file = /src/examples/gwendolen/adaptive/inspection.gwen
mas.builder = gwendolen.GwendolenMASBuilder
env = gwendolen.adaptive.HallwayEnv

hallway.start = room4
hallway.travel = 2
// Uncomment to leave the robot stuck in the hallway: the move times out and is aborted.
// hallway.fault.move(hallway,picture_location) = never

log.info = ail.semantics.adaptive
log.info = gwendolen.adaptive.HallwayEnv
log.warning = ail.mas.DefaultEnvironment
