// The patrol of /src/examples/gwendolen/adaptive/patrol.gwen with a failure threshold of 2:
// a failed move is retried, after returning to where it started, before it is deprecated.

GWENDOLEN

:name: rover

:Initial Beliefs:

:Capabilities:
{at(a)} move(a,b) {at(b), ~at(a)} [threshold 2]
{at(b)} move(b,a) {at(a), ~at(b)} [threshold 2]
{at(a)} move(a,c) {at(c), ~at(a)} [threshold 2]
{at(c)} move(c,a) {at(a), ~at(c)} [threshold 2]
{at(b)} move(b,d) {at(d), ~at(b)} [threshold 2]
{at(d)} move(d,b) {at(b), ~at(d)} [threshold 2]
{at(c)} move(c,d) {at(d), ~at(c)} [threshold 2]
{at(d)} move(d,c) {at(c), ~at(d)} [threshold 2]
{at(a)} move(a,d) {at(d), ~at(a)} [threshold 2]
{at(d)} move(d,a) {at(a), ~at(d)} [threshold 2]
{at(b)} move(b,c) {at(c), ~at(b)} [threshold 2]
{at(c)} move(c,b) {at(b), ~at(c)} [threshold 2]

:Initial Goals:
route [perform]

:Plans:
+!route [perform] : {B at(a)} <- move(a,b), move(b,d), move(d,c), move(c,b), move(b,a);
